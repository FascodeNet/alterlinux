{
    "module_version": 1,
    "manifest_version": 1,
    "arch": "any",
    "load_scripts": [
        "module.sh"
    ],
    "injects": {
        "pre__make_customize_airootfs": [
            "_make_customize_airootfs_user"
        ]
    },
    "options": {
        "usershell": {
            "type": "string",
            "default": "/bin/bash",
            "description": "Login shell of the live user"
        }
    }
}
