{
    "module_version": 1,
    "manifest_version": 1,
    "arch": [
        "x86_64",
        "i686",
        "i486",
        "pentium4"
    ],
    "load_scripts": [
        "module.sh"
    ],
    "injects": {
        "post__make_custom_airootfs": [
            "__alteriso_base_setup_mkinitcpio_presets"
        ]
    },
    "file_permissions": {
        "/etc/shadow": "0:0:400",
        "/usr/local/bin/Installation_guide": "0:0:755",
        "/usr/local/bin/choose-mirror": "0:0:755"
    }
}
