#!/usr/bin/env bash
# shellcheck disable=all

# Initial loader
{{ .LoaderContent }}

__alteriso_loadfile "$__alteriso_profile_dir/injecter.sh"

# Function defines
{{- range $index, $module := .EmbedScripts }}
{{ inject_script $module }}
{{ end }}
# Inject Array
{{ range $func, $codes := .Injects -}}
    {{- $func }}{{ "+=(" }}
        {{- range $index, $code := $codes -}}
            {{ " " }}{{- $code }}
        {{- end -}}
    {{ " )" }}
{{ end -}}
# Variable defines
{{ .ProfileDefContent }}
{{- if .FilePermissions }}
# File permissions from modules
{{ range $path, $permission := .FilePermissions -}}
file_permissions+=( ["{{ $path }}"]="{{ $permission }}" )
{{ end }}
{{- end }}
# Validate alteriso profiles
__alteriso_validate
__alteriso_validate_profile
{{ if .RequireInjectable -}}
__alteriso_require_injectable
{{- end }}

if [[ "$__alteriso_compatible_mode" = "y" ]]; then
    echo "[alteriso] INFO: Running in compatible mode. Injection features are disabled." >&2
    __alteriso_cleanup
    return 0
fi
__alteriso_injected_list
{{- if not .Generation.NoConfirm }}
__alteriso_show_config
{{- end }}
